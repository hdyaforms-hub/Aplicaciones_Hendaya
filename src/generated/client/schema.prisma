  nombreProducto    String?  @map("nombre_producto")
  mes               Int
  numeroCamara      Int      @map("numero_camara")
  temperatura       Float?
  fechaRegistro     DateTime @default(now()) @map("fecha_registro")
  usuarioRegistro   String   @map("usuario_registro")

  registro VTRegistroCabecera @relation(fields: [idRegistro], references: [idRegistro], onDelete: Cascade)

