  descripcionCamaras String?   @map("descripcion_camaras")
  fechaCreacion      DateTime  @default(now()) @map("fecha_creacion")
  usuarioCreacion    String    @map("usuario_creacion")

  configuraciones         VTConfiguracionCamara[]
  detalles                VTRegistroDetalle[]
  verificacionesDiarias   VTVerificacionDiaria[]
  verificacionesSemanales VTVerificacionSemanal[]

