model VTCamara {
  idCamara          Int     @id @default(autoincrement()) @map("id_camara")
  nombreCamara      String  @map("nombre_camara")
  tipoCamara        String  @map("tipo_camara")
  temperaturaMinima Float?  @default(0.0) @map("temperatura_minima")
  temperaturaMaxima Float   @map("temperatura_maxima")
  activo            Boolean @default(true)

  configuraciones VTConfiguracionCamara[]

  @@map("vt_camara")
}

model VTConfiguracionCamara {
  idConfig           Int     @id @default(autoincrement()) @map("id_config")
  idRegistroCabecera Int     @map("id_registro_cabecera")
  idCamara           Int     @map("id_camara")
  mes                Int
  numeroCamaraMes    Int     @map("numero_camara_mes")
  nombreCamara       String? @map("nombre_camara")
  temperaturaMinima  Float?  @default(0.0) @map("temperatura_minima")
  temperaturaMaxima  Float?  @map("temperatura_maxima")

  registro VTRegistroCabecera @relation(fields: [idRegistroCabecera], references: [idRegistro], onDelete: Cascade)
  camara   VTCamara           @relation(fields: [idCamara], references: [idCamara], onDelete: Cascade)

  @@map("vt_configuracion_camara")
