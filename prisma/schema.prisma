model ColegiosMatriz {
  id                    String   @id @default(uuid())
  colRBD                Int      @unique
  nombreEstablecimiento String
  institucion           String
  sucursal              String
  colut                 Int
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model MatrizConfigPregunta {
  id           String   @id @default(uuid())
  preguntaId   String   @unique
  seccion      String
  gravedad     Int
  probabilidad Int
  nivelRiesgo  String
  updatedAt    DateTime @updatedAt
}

model MatrizConfigSemestre {
  id        String   @id @default(uuid())
  anio      Int      @unique @default(2026)
  fechaFin1 DateTime
  updatedAt DateTime @updatedAt
}

model MatrizMitigacion {
  id            String    @id @default(uuid())
  matrizId      String
  preguntaId    String
  fechaSolucion DateTime?
  adjuntos      String?
  usuario       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([matrizId, preguntaId])
}

model TrabajoPreventivo {
  id                    String   @id @default(uuid())
  ut                    Int
  sucursal              String
  licitacion            String
  rbd                   Int
  nombreEstablecimiento String
  folioOT               String
  tipoTrabajo           String
  fechaTrabajo          DateTime
  documentoAsociado     String
  boletasFacturas       String?
  montoMateriales       Int?
  montoManoObra         Int?
  observacion           String?
  usuario               String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model RetornoProductosAlerta {
  id               String                           @id @default(uuid())
  titulo           String
  observacion      String                           
  horas            Int
  estado           String                           @default("ABIERTA")
  color            String?                          @default("yellow")
  archivos         String?
  usuarioCreacion  String
  fechaCreacion    DateTime                         @default(now())
  usuarioCierre    String?
  fechaCierre      DateTime?
  conclusionFinal  String?                          
  movimientos      RetornoProductosMovimiento[]
  sucursalesEstado RetornoProductosSucursalEstado[]
}

model RetornoProductosSucursalEstado {
  id            String                 @id @default(uuid())
  alertaId      String
  sucursalId    String
  estado        String                 @default("PENDIENTE")
  usuarioCierre String?
  fechaCierre   DateTime?
  alerta        RetornoProductosAlerta @relation(fields: [alertaId], references: [id], onDelete: Cascade)
  sucursal      Sucursal               @relation(fields: [sucursalId], references: [id])

  @@unique([alertaId, sucursalId])
}

model RetornoProductosMovimiento {
  id              String                 @id @default(uuid())
  alertaId        String
  sucursalId      String
  usuarioRegistro String
  comentario      String                 
  archivos        String?
  fechaRegistro   DateTime               @default(now())
  alerta          RetornoProductosAlerta @relation(fields: [alertaId], references: [id], onDelete: Cascade)
  sucursal        Sucursal               @relation(fields: [sucursalId], references: [id])
}

model RetornoProductosAlertaHistorialEliminado {
  id                String   @id @default(uuid())
  alertaIdOriginal  String
  tituloAlerta      String
  observacionAlerta String   
  motivoEliminacion String   
  usuarioEliminador String
  fechaEliminacion  DateTime @default(now())
}

model Preparaciones {
  id                String   @id @default(uuid())
  licitacion        String   // varchar(10)
  numeroPreparacion Int      // int
  nombrePreparacion String   // varchar(100)
  numeroPrograma    String   // char(7)
  programa          String   // varchar(150)
  numeroCocina      Int      // int
  cocina            String   // varchar(150)
  numeroArea        String   @db.Char(5)
  area              String   @db.VarChar(150)
  codigoProducto    String   // char(20)
  nombreProducto    String   // varchar(101)
  codigoSubServicio String   // varchar(10)
  nombreSubServicio String   // varchar(100)
  cantPreparacion   Decimal  @db.Decimal(18, 2)
  porcentajePerdida Int      // int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Minutas {
  id                String   @id @default(uuid())
  numeroMinuta      String   @db.VarChar(50)
  licitacion        String   @db.VarChar(10)
  numeroPrograma    String   @db.Char(7)
  programa          String   @db.VarChar(150)
  numeroCocina      Int
  cocina            String   @db.VarChar(150)
  dia               Int
  mes               Int
  anio              Int
  numeroPreparacion BigInt
  sucid             String   @db.Char(15)
  codigoServicio    String   @db.VarChar(10)
  nombreServicio    String   @db.VarChar(100)
  codigoEnlace      Int
  nombreEnlace      String   @db.VarChar(150)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([licitacion])
  @@index([numeroMinuta])
}

model Raciones {
  id                 String   @id @default(uuid())
  licitacion         String   @db.VarChar(10)
  numeroServicio     String   @db.VarChar(10)
  servicio           String   @db.VarChar(100)
  numeroCocina       Int
  numeroArea         String   @db.Char(5)
  numeroEnlace       Int
  numeroLocacion     String   @db.Char(5)
  locacion           String   @db.VarChar(150)
  numeroPrograma     String   @db.Char(7)
  programa           String   @db.VarChar(150)
  mes                Int
  anio               Int      @map("año")
  fecha              DateTime
  estadoRacion       Int
  numeroBeneficiario Int
  beneficiario       String   @db.VarChar(50)
  cantidad           Int
  rbd                Int
  ut                 Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CapCertificacionHeader {
  id               String                   @id @default(uuid())
  rbd              Int
  fecha            DateTime
  servicio         String
  programa         String
  area             String?
  racionesBase     Int                      @default(0)
  racionesDigitadas Int                     @default(0)
  racionesPreparar Int
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  usuario          String?
  motivoCambioAdmin String?
  detalles         CapCertificacionDetail[]
}

model CapCertificacionDetail {
  id                String                 @id @default(uuid())
  headerId          String
  numeroMinuta      String
  nombrePreparacion String
  nombreProducto    String
  grsRac            Decimal                @db.Decimal(18, 2)
  grsTotal          Decimal                @db.Decimal(18, 2)
  header            CapCertificacionHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)
}

model ElementosEsenciales_Cab {
  id                        String                    @id @default(uuid())
  licitacion                String?
  licId                     Int?
  folio                     String?
  fechaSupervision          DateTime?
  rbd                       Int?
  region                    String?
  comuna                    String?
  servicio                  String?
  servicioManual            String?
  observacionManualServicio String?                   @db.Text
  esServicioManual          Boolean                   @default(false)
  horaInicio                String?
  hora                      String?
  obsALosIncumplimiento     String?                   @db.Text
  nombreArchivo             String
  link                      String?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  detalles                  ElementosEsenciales_Det[]
}

model ElementosEsenciales_Det {
  id                                    String                  @id @default(uuid())
  cabId                                 String
  aspecto                               String?                 @db.Text
  observacionesOMedioDeVerificacion     String?                 @db.Text
  co                                    String?
  nc                                    String?
  na                                    String?
  cab                                   ElementosEsenciales_Cab @relation(fields: [cabId], references: [id], onDelete: Cascade)
}

model UTM {
  id        String   @id @default(uuid())
  anho      Int
  mes       Int
  monto     Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([anho, mes])
}

model Multas_Elementos_Esenciales_Cab {
  id                   String   @id @default(uuid())
  folioOriginal        String   @unique
  rbd                  Int
  fechaSupervision     DateTime
  licitacion           String?
  montoTotalCalculado  Float
  estadoCalculo        String   // Ej: "COMPLETO", "INCOMPLETO_POR_PMPA", "INCOMPLETO_POR_DATOS"
  usuarioCalculo       String
  fechaCalculo         DateTime @default(now())
  detalles             Multas_Elementos_Esenciales_Det[]
}

model Multas_Elementos_Esenciales_Det {
  id               String   @id @default(uuid())
  cabId            String
  letraAspecto     String
  descripcion      String?  @db.Text
  formulaAplicada  String?  @db.Text
  montoMulta       Float
  variablesUsadas  String?  @db.Text // JSON con los valores ingresados
  cab              Multas_Elementos_Esenciales_Cab @relation(fields: [cabId], references: [id], onDelete: Cascade)
}

model DescargaPaeLog {
  id            String   @id @default(uuid())
  ano           Int
  mes           Int
  institucion   String
  rbd           Int
  urlGenerada   String   @db.Text
  usuario       String
  fechaDescarga DateTime @default(now())
}

model PaeOnlineCab {
  id              String         @id @default(uuid())
  institucion     String
  mes             Int
  ano             Int
  folio           String         @unique
  establecimiento String
  comuna          String
  rbd             Int
  estrato         String
  programa        String
  licitacion      String
  certificacion   String
  createdAt       DateTime       @default(now())
  detalles        PaeOnlineDet[]
}

model PaeOnlineDet {
  id              String       @id @default(uuid())
  cabId           String
  dia             Int
  serCompletas    Float
  serIncompletas  Float
  codProducto     String       @db.VarChar(50)
  noServido       Float
  codCausa        String       @db.VarChar(50)
  totalRaciones   Float
  cab             PaeOnlineCab @relation(fields: [cabId], references: [id], onDelete: Cascade)
}

model CodigoCausa {
  id          Int      @id
  descripcion String
  imputable   String   @default("Imputable")
  definicion  String   @default("")
  createdAt   DateTime @default(now())
}

// Tipos de vehículo personalizables (Camión, Camioneta, etc.)
model TipoVehiculo {
  id        String     @id @default(uuid())
  nombre    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  vehiculos Vehiculo[]
}

// Registro de vehículos / camionetas
model Vehiculo {
  id             String               @id @default(uuid())
  patente        String               @unique
  utId           Int?                 // Opcional para soportar sucursales sin UT (ej. Casa Matriz)
  sucursalId     String
  tipoVehiculoId String
  licId          Int?                 // Opcional: Licitación asociada
  utIds          String?              // Lista JSON de UTs asociadas "[codUT1, codUT2]"
  vigente        Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  ut              UT?                     @relation(fields: [utId], references: [codUT])
  sucursal        Sucursal                @relation(fields: [sucursalId], references: [id])
  tipoVehiculo    TipoVehiculo            @relation(fields: [tipoVehiculoId], references: [id])
  licitacion      Licitacion?             @relation(fields: [licId], references: [licId])
  supervisores    SupervisorVehiculo[]
  jefesZonales    JefeZonalVehiculo[]
  jefesOperacion  JefeOperacionVehiculo[]
}

// Jefes Zonales
model JefeZonal {
  id             String                @id @default(uuid())
  nombre         String
  apellido       String
  correo         String
  vigente        Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  licitaciones   JefeZonalLicitacion[]
  sucursales     JefeZonalSucursal[]
  vehiculos      JefeZonalVehiculo[]   // Patentes/vehículos asignados al zonal
  jefesOperacion JefeOperacion[]
  supervisores   Supervisor[]          // Directos si no hay Jefe de Operación
}

// Relaciones Muchos a Muchos para Jefe Zonal
model JefeZonalLicitacion {
  jefeZonalId  String
  licitacionId Int

  jefeZonal  JefeZonal  @relation(fields: [jefeZonalId], references: [id], onDelete: Cascade)
  licitacion Licitacion @relation(fields: [licitacionId], references: [licId], onDelete: Cascade)

  @@id([jefeZonalId, licitacionId])
}

model JefeZonalSucursal {
  jefeZonalId String
  sucursalId  String

  jefeZonal JefeZonal @relation(fields: [jefeZonalId], references: [id], onDelete: Cascade)
  sucursal  Sucursal  @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@id([jefeZonalId, sucursalId])
}

// Relación Muchos a Muchos entre Jefe Zonal y Vehículos
model JefeZonalVehiculo {
  jefeZonalId String
  vehiculoId  String

  jefeZonal JefeZonal @relation(fields: [jefeZonalId], references: [id], onDelete: Cascade)
  vehiculo  Vehiculo  @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)

  @@id([jefeZonalId, vehiculoId])
}

// Jefes de Operación
model JefeOperacion {
  id          String       @id @default(uuid())
  nombre      String
  apellido    String
  correo      String
  jefeZonalId String
  vigente     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  jefeZonal    JefeZonal              @relation(fields: [jefeZonalId], references: [id])
  supervisores Supervisor[]
  vehiculos    JefeOperacionVehiculo[] // Patentes/vehículos asignados al jefe
}

// Relación Muchos a Muchos entre Jefe de Operación y Vehículos
model JefeOperacionVehiculo {
  jefeOperacionId String
  vehiculoId      String

  jefeOperacion JefeOperacion @relation(fields: [jefeOperacionId], references: [id], onDelete: Cascade)
  vehiculo      Vehiculo      @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)

  @@id([jefeOperacionId, vehiculoId])
}

// Supervisores de Operación
model Supervisor {
  id              String               @id @default(uuid())
  nombre          String
  apellido        String
  correo          String
  jefeOperacionId String?
  jefeZonalId     String?              // Para supervisores directos a Zonal
  vigente         Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  jefeOperacion JefeOperacion?       @relation(fields: [jefeOperacionId], references: [id])
  jefeZonal     JefeZonal?           @relation(fields: [jefeZonalId], references: [id])
  camionetas    SupervisorVehiculo[]
  rbdsAuditar   SupervisorRbd[]
}

// Relación Muchos a Muchos entre Supervisor y Vehículos/Camionetas
model SupervisorVehiculo {
  supervisorId String
  vehiculoId   String

  supervisor Supervisor @relation(fields: [supervisorId], references: [id], onDelete: Cascade)
  vehiculo   Vehiculo   @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)

  @@id([supervisorId, vehiculoId])
}

// Relación Muchos a Muchos para los RBDs que audita un Supervisor
model SupervisorRbd {
  id           String     @id @default(uuid())
  supervisorId String
  rbd          Int
  createdAt    DateTime   @default(now())

  supervisor Supervisor @relation(fields: [supervisorId], references: [id], onDelete: Cascade)

  @@unique([supervisorId, rbd])
}

model DistanciaCache {
  id          String   @id @default(uuid())
  sucursal    String   // Nombre de la sucursal de origen
  rbd         Int      // RBD del colegio de destino
  distanciaKm Float    // Distancia por carretera en kilómetros
  duracionMin Int      // Tiempo estimado de viaje en minutos
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sucursal, rbd])
}

model ConsumoApiGoogle {
  id        String   @id @default(uuid())
  mes       Int      // Mes calendario (1-12)
  anio      Int      // Año calendario
  cantidad  Int      @default(0) // Peticiones realizadas en este mes/año
  updatedAt DateTime @updatedAt

  @@unique([mes, anio], name: "mes_anio")
}

model Cab_LeePdfEstandarPae {
  id                            String   @id @default(uuid())
  NombreArchivoPdf              String
  Licitacion                    Int?
  Folio                         String   @unique
  Res_Sanitaria_N               String?
  Nombre_Num_establecimiento    String?
  RBD                           Int?
  Region                        String?
  Comuna                        String?
  Fecha_Supervision             DateTime?
  Porcentaje_cumplimiento_final Float?
  Observaciones                 String?  @db.Text
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  detalles Det_LeePdfEstandarPae[]
}

model Det_LeePdfEstandarPae {
  id                       String   @id @default(uuid())
  cabeceraId               String
  Infraestructura          String?  @db.Text
  Calificacion             String?
  Descripcion              String?  @db.Text
  Comprometiendo_Inocuidad String?
  Tipo_NC                  String?
  Otros_Comentarios        String?  @db.Text

  cabecera Cab_LeePdfEstandarPae @relation(fields: [cabeceraId], references: [id], onDelete: Cascade)
}

model MatrizT_Cabecera {
  id            String                       @id @default(uuid())
  licId         Int
  anio          Int
  titulo        String
  estado        Boolean                      @default(true) // true = Vigente, false = No vigente
  instrucciones String?                      @db.Text
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  licitacion    Licitacion                   @relation(fields: [licId], references: [licId])
  detalles      MatrizT_Detalle[]
  respuestas    MatrizT_RespuestasCabecera[]
  formatosCarta FormatoCartaSostenedor[]
}

model MatrizT_Detalle {
  id                    String                      @id @default(uuid())
  cabeceraId            String
  preguntaNombre        String
  tipoRespuesta         String                      // SI_NO, EXISTE_NO_EXISTE, ENCUESTA, OBSERVACION, ADJUNTAR
  obligatorio           Boolean                     @default(false)
  seccion               String                      // PATIO_SERVICIO, BODEGA, COCINA, BANO, LEVANTAMIENTO_GENERAL
  orden                 Int                         @default(0)

  // Calculo Matriz
  gravedad              Int?                        // 1: Bajo, 2: Medio, 3: Alto
  probabilidad          Int?                        // 1: Bajo, 2: Medio, 3: Alto
  nivelRiesgo           Int?                        // 1: Bajo, 2: Medio, 3: Alto
  justificacion         String?                     @db.Text

  // Hoja B Estándar Pae
  riesgoSignificativo   String?                     @db.Text
  recursoNecesario      String?                     @db.Text
  resultadoEsperado     String?                     @db.Text
  respImplementacion    String?                     @db.Text
  respSeguimiento       String?                     @db.Text
  evidenciaCumplimiento String?                     @db.Text
  evidenciaEficacia     String?                     @db.Text
  compromisoSostenedor  String?                     @db.Text

  cabecera              MatrizT_Cabecera            @relation(fields: [cabeceraId], references: [id], onDelete: Cascade)
  respuestasDetalle     MatrizT_RespuestasDetalle[]
}

model MatrizT_RespuestasCabecera {
  id                       String                      @id @default(uuid())
  cabeceraId               String
  usuario                  String
  fechaIngreso             DateTime                    @default(now())
  supervisorNombre         String
  supervisorCorreo         String
  usuarioOriginal          String?
  supervisorNombreOriginal String?
  supervisorCorreoOriginal String?
  fechaReemplazo           DateTime?
  licId                    Int
  ut                       Int
  rbd                      Int
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  estado                   String                      @default("pendiente")
  latIngreso               Float?
  lngIngreso               Float?
  latCierre                Float?
  lngCierre                Float?

  cabecera                 MatrizT_Cabecera            @relation(fields: [cabeceraId], references: [id])
  detalles                 MatrizT_RespuestasDetalle[]
}

model MatrizT_RespuestasDetalle {
  id                  String                     @id @default(uuid())
  respuestaCabeceraId String
  preguntaId          String
  valor               String?
  adjuntoUrl          String?

  respuestaCabecera   MatrizT_RespuestasCabecera @relation(fields: [respuestaCabeceraId], references: [id], onDelete: Cascade)
  pregunta            MatrizT_Detalle            @relation(fields: [preguntaId], references: [id])
}

model FormatoCartaSostenedor {
  id           String           @id @default(uuid())
  cabeceraId   String
  nombre       String           // Ej: "Activos", "Licitación"
  asuntoEmail  String           @db.Text
  cuerpoEmail  String           @db.Text
  cuerpoInicio String           @db.Text // Texto del encabezado de la carta PDF
  cuerpoFin    String           @db.Text // Texto del pie de firma de la carta PDF
  activo       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  cabecera     MatrizT_Cabecera @relation(fields: [cabeceraId], references: [id], onDelete: Cascade)
}


model DelegacionVisualizacion {
  id          String   @id @default(uuid())
  userId      String
  sucursalId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sucursal    Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@unique([userId, sucursalId])
}

model MenuItemOrder {
  id        String   @id @default(uuid())
  parentKey String   // "" para nivel superior, o nombre de la opción padre (ej: "Matriz de riesgo")
  itemKey   String   // Nombre del ítem de menú (ej: "Cerrar Matriz de Riesgo")
  position  Int      // Índice de posición (0, 1, 2...)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parentKey, itemKey])
}




